 .../CAMPAIGN_V3_SUMMARY.json                  | 17 ++++----
 .../PROSPECTIVE_CAMPAIGN_V3.jsonl             | 32 +++++++-------
 tests/test_prospective_campaign_v3.py         | 14 +++++++
