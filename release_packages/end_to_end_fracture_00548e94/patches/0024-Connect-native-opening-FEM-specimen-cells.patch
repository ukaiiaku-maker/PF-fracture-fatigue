                 if law == "original_activated_opening":
-                    row["readiness"]["implementation"] = "UNRESOLVED_GENERIC_FEM_ADAPTER"
-                    row["readiness"]["native_qualification"] = "PENDING_THREE_LEVEL_SPECIMEN"
+                    row["readiness"].update({
