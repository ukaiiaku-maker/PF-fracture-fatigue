+        for left, right in zip(points[:-1], points[1:]):
+            slope = math.log(float(right["rate_20_60_m_per_cycle"])
+                             / float(left["rate_20_60_m_per_cycle"])) / math.log(
+                                 float(right["DeltaK_MPa_sqrt_m"])
+                                 / float(left["DeltaK_MPa_sqrt_m"]))
+            slope_rows.append({
